{
    "name": "jundayw/composer-version-plugin",
    "description": "A Composer plugin for semantic version bumping, Git commit and tag automation.",
    "keywords": [
        "composer version",
        "ComposerVersionPlugin",
        "composer-version-plugin"
    ],
    "type": "composer-plugin",
    "license": "MIT",
    "homepage": "https://github.com/jundayw/composer-version-plugin",
    "authors": [
        {
            "name": "jundayw",
            "email": "jundayw@126.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.2",
        "phlak/semver": "^4.0",
        "symfony/process": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "composer/composer": "^2.10",
        "code-lts/doctum": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Jundayw\\ComposerVersion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs": "@php vendor/bin/doctum.php update doctum.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "class": "Jundayw\\ComposerVersion\\VersionPlugin"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
